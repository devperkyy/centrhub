<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- hand-drawn geometry icons, 24x24 viewport, 1.6 stroke feel via path thickness -->
    <!-- not Material/FontAwesome - custom shapes -->

    <!-- play: offset triangle, slightly rounded -->
    <Geometry x:Key="IcPlay">M8,5.5 L8,18.5 Q8,19.5 8.9,19 L19,12.6 Q19.9,12 19,11.4 L8.9,5 Q8,4.5 8,5.5 Z</Geometry>

    <!-- stop: squircle -->
    <Geometry x:Key="IcStop">M6.5,5 L17.5,5 Q19,5 19,6.5 L19,17.5 Q19,19 17.5,19 L6.5,19 Q5,19 5,17.5 L5,6.5 Q5,5 6.5,5 Z</Geometry>

    <!-- inject: downward angled arrow into bracket -->
    <Geometry x:Key="IcInject">M12,3 L12,14 M8,10 L12,14 L16,10 M4,17 L4,20 L20,20 L20,17</Geometry>

    <!-- clear: broom-like stroke -->
    <Geometry x:Key="IcClear">M5,19 L10,14 M14,5 L19,10 L14,15 L9,10 Z M9,10 L4,15 L4,19 L8,19</Geometry>

    <!-- scripts: layered rectangles -->
    <Geometry x:Key="IcScripts">M6,4 L16,4 L19,7 L19,18 Q19,20 17,20 L6,20 Q4,20 4,18 L4,6 Q4,4 6,4 Z M16,4 L16,7 L19,7</Geometry>

    <!-- executor: terminal prompt chevron -->
    <Geometry x:Key="IcExecutor">M4,6 L4,18 Q4,20 6,20 L18,20 Q20,20 20,18 L20,6 Q20,4 18,4 L6,4 Q4,4 4,6 Z M7,9 L10,12 L7,15 M12,15 L16,15</Geometry>

    <!-- settings: gear with 6 teeth, not 8 -->
    <Geometry x:Key="IcSettings">M12,8.5 A3.5,3.5 0 1 0 12,15.5 A3.5,3.5 0 1 0 12,8.5 M12,2 L12,5 M12,19 L12,22 M4.2,7 L6.8,8.5 M17.2,15.5 L19.8,17 M4.2,17 L6.8,15.5 M17.2,8.5 L19.8,7</Geometry>

    <!-- github: offset mark -->
    <Geometry x:Key="IcGithub">M12,2 C6.5,2 2,6.6 2,12.2 C2,16.7 4.9,20.5 8.9,21.8 C9.4,21.9 9.6,21.6 9.6,21.3 L9.6,19.4 C6.8,20 6.2,18 6.2,18 C5.7,16.8 5,16.5 5,16.5 C4,15.9 5.1,15.9 5.1,15.9 C6.2,16 6.8,17 6.8,17 C7.8,18.7 9.4,18.2 10,18 C10.1,17.3 10.4,16.8 10.7,16.5 C8.4,16.3 6.1,15.4 6.1,11.6 C6.1,10.5 6.5,9.6 7.1,8.9 C7,8.6 6.6,7.5 7.2,6 C7.2,6 8.1,5.7 10,7 C10.9,6.8 11.8,6.7 12.7,6.7 C13.6,6.7 14.5,6.8 15.4,7 C17.3,5.7 18.2,6 18.2,6 C18.8,7.5 18.4,8.6 18.3,8.9 C18.9,9.6 19.3,10.5 19.3,11.6 C19.3,15.4 17,16.3 14.7,16.5 C15.1,16.9 15.4,17.6 15.4,18.6 L15.4,21.3 C15.4,21.6 15.6,21.9 16.1,21.8 C20.1,20.5 23,16.7 23,12.2 C23,6.6 18.5,2 12,2 Z</Geometry>

    <!-- close, minimize, maximize - window glyphs -->
    <Geometry x:Key="IcClose">M6,6 L18,18 M18,6 L6,18</Geometry>
    <Geometry x:Key="IcMin">M5,12 L19,12</Geometry>
    <Geometry x:Key="IcMax">M6,6 L18,6 L18,18 L6,18 Z</Geometry>

    <!-- status dot pulse base -->
    <Geometry x:Key="IcDot">M12,10 A2,2 0 1 0 12,14 A2,2 0 1 0 12,10 Z</Geometry>
</ResourceDictionary>
