<UserControl x:Class="RobloxExecutor.Views.ExecutorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:avalon="http://icsharpcode.net/sharpdevelop/avalonedit"
             Background="{DynamicResource Bg0Brush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="180"/>
        </Grid.RowDefinitions>

        <!-- action bar -->
        <Border Grid.Row="0" Background="{DynamicResource Bg0Brush}"
                BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
                <Button Style="{StaticResource PrimaryButton}"
                        Command="{Binding ExecuteCommand}"
                        IsEnabled="{Binding IsAttached}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IcPlay}" Width="14" Height="14" Stretch="Uniform"
                              Fill="White"/>
                        <TextBlock Text="Execute" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource GhostButton}" Margin="10,0,0,0"
                        Command="{Binding InjectCommand}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IcInject}" Width="14" Height="14" Stretch="Uniform"
                              Stroke="{DynamicResource Fg0Brush}" StrokeThickness="1.6" Fill="Transparent"/>
                        <TextBlock Text="Attach" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource GhostButton}" Margin="10,0,0,0"
                        Command="{Binding ClearCommand}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IcClear}" Width="14" Height="14" Stretch="Uniform"
                              Stroke="{DynamicResource Fg0Brush}" StrokeThickness="1.6" Fill="Transparent"/>
                        <TextBlock Text="Clear" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- tab strip -->
        <Border Grid.Row="1" Background="{DynamicResource Bg0Brush}"
                BorderBrush="{DynamicResource LineSoftBrush}" BorderThickness="0,0,0,1">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="30" Height="30"
                        Command="{Binding NewTabCommand}" Margin="0,0,10,0" ToolTip="New tab">
                    <TextBlock Text="+" FontSize="18" Margin="0,-2,0,0"
                               Foreground="{DynamicResource Fg1Brush}"/>
                </Button>
                <TabControl ItemsSource="{Binding Tabs}" SelectedItem="{Binding ActiveTab}"
                            Background="Transparent" BorderThickness="0" Padding="12,4,0,0">
                    <TabControl.ItemContainerStyle>
                        <Style TargetType="TabItem" BasedOn="{StaticResource ScriptTabItem}"/>
                    </TabControl.ItemContainerStyle>
                    <TabControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Title}"/>
                        </DataTemplate>
                    </TabControl.ItemTemplate>
                    <TabControl.ContentTemplate>
                        <DataTemplate>
                            <Grid/>
                        </DataTemplate>
                    </TabControl.ContentTemplate>
                </TabControl>
            </DockPanel>
        </Border>

        <!-- editor -->
        <Border Grid.Row="2" Background="{DynamicResource Bg1Brush}" Margin="14,10,14,0" CornerRadius="10"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
            <avalon:TextEditor x:Name="Editor"
                               FontFamily="Cascadia Mono, Consolas"
                               FontSize="13"
                               Background="Transparent"
                               Foreground="{DynamicResource Fg0Brush}"
                               ShowLineNumbers="True"
                               Padding="12"
                               Loaded="Editor_Loaded"/>
        </Border>

        <!-- splitter -->
        <GridSplitter Grid.Row="3" Height="6" HorizontalAlignment="Stretch" Background="Transparent"/>

        <!-- console -->
        <Border Grid.Row="4" Background="{DynamicResource Bg1Brush}" Margin="14,0,14,14" CornerRadius="10"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Console" FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource Fg1Brush}" Margin="14,8,0,0"/>
                <ScrollViewer Grid.Row="1" x:Name="ConsoleScroll" VerticalScrollBarVisibility="Auto"
                              Padding="14,2,14,10">
                    <TextBlock Text="{Binding ConsoleBuffer}" FontFamily="Cascadia Mono, Consolas"
                               FontSize="12" Foreground="{DynamicResource Fg0Brush}"
                               TextWrapping="Wrap"/>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
