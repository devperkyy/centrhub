<UserControl x:Class="RobloxExecutor.Views.ScriptsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Bg0Brush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Scripts" FontSize="20" FontWeight="SemiBold"
                   Foreground="{DynamicResource Fg0Brush}"/>
        <TextBlock Grid.Row="0" Text="library + github raw import" Margin="0,30,0,0"
                   FontSize="12" Foreground="{DynamicResource Fg2Brush}"/>

        <Border Grid.Row="1" Background="{DynamicResource Bg1Brush}" CornerRadius="10"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Margin="0,14,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Path Data="{StaticResource IcGithub}" Width="18" Height="18" Stretch="Uniform"
                      Fill="{DynamicResource Fg1Brush}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" Text="{Binding GithubUrl, UpdateSourceTrigger=PropertyChanged}"
                         Background="Transparent" BorderThickness="0"
                         Foreground="{DynamicResource Fg0Brush}" FontSize="13"
                         VerticalAlignment="Center" Padding="0,0,0,0"
                         CaretBrush="{DynamicResource AccentBrush}">
                    <TextBox.Resources>
                        <VisualBrush x:Key="PH" AlignmentX="Left" AlignmentY="Center" Stretch="None">
                            <VisualBrush.Visual>
                                <TextBlock Text="https://github.com/user/repo/blob/main/script.lua  or  gh:user/repo@main/script.lua"
                                           Foreground="{DynamicResource Fg2Brush}" FontSize="13"/>
                            </VisualBrush.Visual>
                        </VisualBrush>
                    </TextBox.Resources>
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Background" Value="{StaticResource PH}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
                <Button Grid.Column="2" Style="{StaticResource PrimaryButton}"
                        Content="Import" Margin="10"
                        Command="{Binding ImportGithubCommand}"/>
            </Grid>
        </Border>

        <TextBlock Grid.Row="2" Text="{Binding ImportLog}" Margin="4,8,0,8"
                   FontSize="11" Foreground="{DynamicResource Fg2Brush}"/>

        <Border Grid.Row="3" Background="{DynamicResource Bg1Brush}" CornerRadius="10"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
            <ListBox ItemsSource="{Binding Library}" Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Height="42">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Margin="14,0,0,0"
                                       Foreground="{DynamicResource Fg0Brush}"/>
                            <TextBlock Grid.Column="1" Text="{Binding Path}" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Fg2Brush}" FontSize="10"
                                       Margin="0,0,14,0"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </Grid>
</UserControl>
