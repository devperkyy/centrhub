<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- shared easings -->
    <QuinticEase x:Key="EaseSoft" EasingMode="EaseOut"/>
    <CubicEase   x:Key="EaseSnap" EasingMode="EaseOut"/>

    <!-- window entrance: fade + rise -->
    <Storyboard x:Key="SbWindowEntrance">
        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                         From="0" To="1" Duration="0:0:0.32" EasingFunction="{StaticResource EaseSoft}"/>
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                         From="12" To="0" Duration="0:0:0.32" EasingFunction="{StaticResource EaseSoft}"/>
    </Storyboard>

    <!-- content fade when nav page switches -->
    <Storyboard x:Key="SbContentFade">
        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                         From="0" To="1" Duration="0:0:0.22" EasingFunction="{StaticResource EaseSoft}"/>
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                         From="6" To="0" Duration="0:0:0.22" EasingFunction="{StaticResource EaseSoft}"/>
    </Storyboard>

    <!-- primary button pulse on click -->
    <Storyboard x:Key="SbButtonPulse">
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                         From="0.96" To="1" Duration="0:0:0.18" EasingFunction="{StaticResource EaseSoft}"/>
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                         From="0.96" To="1" Duration="0:0:0.18" EasingFunction="{StaticResource EaseSoft}"/>
    </Storyboard>
</ResourceDictionary>
