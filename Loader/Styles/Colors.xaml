<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- obsidian palette - near-black with one cool accent, no stock blue -->
    <Color x:Key="Bg0">#0B0C10</Color>
    <Color x:Key="Bg1">#111218</Color>
    <Color x:Key="Bg2">#15171F</Color>
    <Color x:Key="Bg3">#1C1E27</Color>
    <Color x:Key="Line">#242734</Color>
    <Color x:Key="LineSoft">#1A1C25</Color>
    <Color x:Key="Fg0">#E6E8EF</Color>
    <Color x:Key="Fg1">#A8ADBD</Color>
    <Color x:Key="Fg2">#6B7085</Color>
    <Color x:Key="Accent">#7C5CFF</Color>
    <Color x:Key="AccentSoft">#4A3BA0</Color>
    <Color x:Key="Danger">#E5484D</Color>
    <Color x:Key="Good">#30A46C</Color>

    <SolidColorBrush x:Key="Bg0Brush" Color="{StaticResource Bg0}"/>
    <SolidColorBrush x:Key="Bg1Brush" Color="{StaticResource Bg1}"/>
    <SolidColorBrush x:Key="Bg2Brush" Color="{StaticResource Bg2}"/>
    <SolidColorBrush x:Key="Bg3Brush" Color="{StaticResource Bg3}"/>
    <SolidColorBrush x:Key="LineBrush" Color="{StaticResource Line}"/>
    <SolidColorBrush x:Key="LineSoftBrush" Color="{StaticResource LineSoft}"/>
    <SolidColorBrush x:Key="Fg0Brush" Color="{StaticResource Fg0}"/>
    <SolidColorBrush x:Key="Fg1Brush" Color="{StaticResource Fg1}"/>
    <SolidColorBrush x:Key="Fg2Brush" Color="{StaticResource Fg2}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoft}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource Danger}"/>
    <SolidColorBrush x:Key="GoodBrush" Color="{StaticResource Good}"/>
</ResourceDictionary>
