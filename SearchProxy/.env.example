# Copy this file to .env and fill in your own values. Never commit .env.

# From Google Cloud Console -> APIs & Services -> Credentials -> API key
GOOGLE_API_KEY=

# From programmablesearchengine.google.com -> your search engine -> Search engine ID
GOOGLE_CSE_ID=

# Port the proxy listens on (optional)
PORT=8787

# Comma-separated list of origins allowed to call this proxy from a browser.
# Use * only for local testing.
ALLOWED_ORIGINS=*
