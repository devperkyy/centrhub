<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- base text -->
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI"/>
        <Setter Property="Foreground" Value="{DynamicResource Fg0Brush}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>

    <!-- icon button: 36x36, rounded 10, hover lift -->
    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Fg1Brush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="PART_Bg"
                            Background="{TemplateBinding Background}"
                            CornerRadius="10">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PART_Bg" Property="Background" Value="{DynamicResource Bg3Brush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Fg0Brush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PART_Bg" Property="Background" Value="{DynamicResource LineBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- primary action: accent fill, pill -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Height" Value="34"/>
        <Setter Property="MinWidth" Value="92"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="PART_Bg"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="PART_Scale" ScaleX="1" ScaleY="1"/>
                        </Border.RenderTransform>
                        <Border.Effect>
                            <DropShadowEffect Color="#7C5CFF" Opacity="0.35" BlurRadius="18" ShadowDepth="0"/>
                        </Border.Effect>
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PART_Bg" Property="Background" Value="#8E70FF"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PART_Scale" Storyboard.TargetProperty="ScaleX" To="1.02" Duration="0:0:0.14"/>
                                        <DoubleAnimation Storyboard.TargetName="PART_Scale" Storyboard.TargetProperty="ScaleY" To="1.02" Duration="0:0:0.14"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PART_Scale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.14"/>
                                        <DoubleAnimation Storyboard.TargetName="PART_Scale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.14"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PART_Bg" Property="Background" Value="#6B4FE6"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PART_Scale" Storyboard.TargetProperty="ScaleX" To="0.97" Duration="0:0:0.08"/>
                                        <DoubleAnimation Storyboard.TargetName="PART_Scale" Storyboard.TargetProperty="ScaleY" To="0.97" Duration="0:0:0.08"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="PART_Bg" Property="Background" Value="{DynamicResource Bg3Brush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Fg2Brush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ghost action -->
    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Fg0Brush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="PART_Bg"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource LineBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PART_Bg" Property="Background" Value="{DynamicResource Bg3Brush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- side nav item -->
    <Style x:Key="NavItem" TargetType="RadioButton">
        <Setter Property="Height" Value="44"/>
        <Setter Property="Foreground" Value="{DynamicResource Fg1Brush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border x:Name="Rail"
                                Width="3"
                                HorizontalAlignment="Left"
                                Margin="0,10"
                                CornerRadius="2"
                                Background="Transparent"/>
                        <Border x:Name="PART_Bg"
                                Background="Transparent"
                                CornerRadius="10"
                                Margin="8,2,8,2">
                            <ContentPresenter Margin="14,0,10,0"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PART_Bg" Property="Background" Value="{DynamicResource Bg2Brush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Fg0Brush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="PART_Bg" Property="Background" Value="{DynamicResource Bg3Brush}"/>
                            <Setter TargetName="Rail" Property="Background" Value="{DynamicResource AccentBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Fg0Brush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- script tab (editor tabs) -->
    <Style x:Key="ScriptTabItem" TargetType="TabItem">
        <Setter Property="Foreground" Value="{DynamicResource Fg1Brush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="PART_Bg"
                            Padding="14,6"
                            Margin="0,0,2,0"
                            CornerRadius="8,8,0,0"
                            Background="Transparent">
                        <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="PART_Bg" Property="Background" Value="{DynamicResource Bg2Brush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Fg0Brush}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PART_Bg" Property="Background" Value="{DynamicResource Bg2Brush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- status pill -->
    <Style x:Key="StatusPill" TargetType="Border">
        <Setter Property="CornerRadius" Value="999"/>
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="Background" Value="{DynamicResource Bg2Brush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>
</ResourceDictionary>
